# Server configuration
PORT=4000
NODE_ENV=development

# Session JWT signing secret (required in production; auto-generated in local dev if unset)
JWT_SECRET=replace-with-a-32-plus-byte-random-secret

# Google OAuth 2.0 / Google Identity Services
# Leave blank for seamless Local Dev/Demo Google Auth mode
GOOGLE_CLIENT_ID=
ALLOW_DEV_AUTH=true

# Backblaze B2 S3-Compatible Cloud Storage
# Leave blank to use transparent local filesystem fallback (.data/b2-local-storage)
B2_ENDPOINT=
B2_REGION=us-west-004
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Local filesystem fallback directory when B2 credentials are absent
STORAGE_LOCAL_DIR=.data/b2-local-storage
